{
  "name": "Daily APOD digest",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 8 * * *"
            }
          ]
        }
      },
      "id": "5f0e1a2b-0001-4c1a-9a01-a0d000000001",
      "name": "Every morning at 08:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "c0f1a001-0000-4000-8000-000000000001",
              "name": "apodBaseUrl",
              "value": "https://your-app.fly.dev",
              "type": "string"
            },
            {
              "id": "c0f1a001-0000-4000-8000-000000000002",
              "name": "discordWebhookUrl",
              "value": "https://discord.com/api/webhooks/REPLACE_ME",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "5f0e1a2b-0002-4c1a-9a01-a0d000000002",
      "name": "Settings (edit me)",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [220, 0],
      "notes": "Set the app's URL and your Discord webhook URL here. Treat the webhook URL as a secret: anyone with it can post to your channel."
    },
    {
      "parameters": {
        "url": "={{ $json.apodBaseUrl }}/api/apod",
        "options": {
          "timeout": 30000
        }
      },
      "id": "5f0e1a2b-0003-4c1a-9a01-a0d000000003",
      "name": "Get today's APOD",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 0],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "notes": "Retries because NASA (behind the app) is sometimes slow."
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "c0f1a001-0000-4000-8000-000000000003",
              "leftValue": "={{ $json.placeholder === true }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "false",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "5f0e1a2b-0004-4c1a-9a01-a0d000000004",
      "name": "Real picture?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [660, 0],
      "notes": "Skips days when NASA's API returned its generic placeholder page."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Settings (edit me)').item.json.discordWebhookUrl }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  username: 'APOD Explorer',\n  embeds: [{\n    title: $json.title,\n    url: $('Settings (edit me)').item.json.apodBaseUrl + '/?date=' + $json.date,\n    description: ($json.explanation || '').slice(0, 1000) + (($json.explanation || '').length > 1000 ? '…' : ''),\n    image: $json.media_type === 'image' ? { url: $json.url } : undefined,\n    thumbnail: $json.media_type === 'video' && $json.thumbnail_url ? { url: $json.thumbnail_url } : undefined,\n    footer: { text: $json.date + ($json.copyright ? ', ' + $json.copyright.trim() : '') }\n  }]\n}) }}",
        "options": {}
      },
      "id": "5f0e1a2b-0005-4c1a-9a01-a0d000000005",
      "name": "Post to Discord",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, -100],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "fromEmail": "apod@example.com",
        "toEmail": "you@example.com",
        "subject": "={{ 'Astronomy Picture of the Day: ' + $json.title }}",
        "emailFormat": "html",
        "html": "={{ '<h2>' + $json.title.replace(/[<>&]/g, '') + '</h2><p>' + $json.date + '</p>' + ($json.media_type === 'image' ? '<p><img src=\"' + encodeURI($json.url) + '\" alt=\"\" style=\"max-width:100%\"></p>' : '') + '<p>' + ($json.explanation || '').replace(/[<>&]/g, '') + '</p><p><a href=\"' + $('Settings (edit me)').item.json.apodBaseUrl + '/?date=' + $json.date + '\">Open in APOD Explorer</a></p>' }}",
        "options": {}
      },
      "id": "5f0e1a2b-0006-4c1a-9a01-a0d000000006",
      "name": "Send email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [900, 100],
      "disabled": true,
      "notes": "Disabled by default. To use it: add SMTP credentials, set the addresses, then enable the node."
    }
  ],
  "connections": {
    "Every morning at 08:00": {
      "main": [[{ "node": "Settings (edit me)", "type": "main", "index": 0 }]]
    },
    "Settings (edit me)": {
      "main": [[{ "node": "Get today's APOD", "type": "main", "index": 0 }]]
    },
    "Get today's APOD": {
      "main": [[{ "node": "Real picture?", "type": "main", "index": 0 }]]
    },
    "Real picture?": {
      "main": [
        [
          { "node": "Post to Discord", "type": "main", "index": 0 },
          { "node": "Send email", "type": "main", "index": 0 }
        ],
        []
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "tags": []
}
