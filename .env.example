# Copy to .env and fill in real values. Never commit .env.

# HTTP port to listen on.
PORT=8080

# NASA API key from https://api.nasa.gov (DEMO_KEY works but is heavily rate-limited).
NASA_API_KEY=DEMO_KEY

# How long upstream API responses are cached in memory (Go duration syntax).
CACHE_TTL=10m

# Path to the SQLite database file.
DB_PATH=app.db

# Optional: free key from https://api.le-systeme-solaire.net/generatekey.html
SOLAR_SYSTEM_API_KEY=

# Optional: enables live model answers for the image helpers (offline text otherwise).
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
