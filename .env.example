# Copy to .env and fill in real values. Never commit .env.
# The app doesn't read this file itself; load it with:
#   set -a; source .env; set +a
# See docs/DEPLOYMENT.md for where each key comes from.

# ---- Server -----------------------------------------------------------------
PORT=8080
DB_PATH=app.db
LOG_FORMAT=text            # text or json

# ---- Keys ---------------------------------------------------------------------
# https://api.nasa.gov (DEMO_KEY works but is heavily rate-limited)
NASA_API_KEY=DEMO_KEY
# Generate with: openssl rand -base64 48   (at least 32 characters)
SESSION_SECRET=
# Optional: https://api.le-systeme-solaire.net/generatekey.html
SOLAR_SYSTEM_API_KEY=
# Optional: live answers for the explanation tools
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini

# ---- Behaviour ---------------------------------------------------------------
CACHE_TTL=10m              # how long upstream responses stay in memory
DEMO_MODE=0                # 1 = built-in sample images instead of NASA's API
SESSION_TTL=720h           # how long a login lasts
COOKIE_SECURE=true         # false only for plain-HTTP testing off localhost
RATE_LIMIT_RPS=5           # per-IP requests per second on /api/
RATE_LIMIT_BURST=20
APP_ORIGIN=                # another origin allowed to call the API (CORS); empty = same-origin only
TRUSTED_PROXY_HEADER=      # e.g. Fly-Client-IP behind Fly.io's proxy
